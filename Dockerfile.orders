FROM node:20-bullseye AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Copy source code
COPY apps/orders ./apps/orders
COPY libs ./libs

# Install dependencies and build
RUN npm ci
RUN npx prisma generate --schema=apps/orders/prisma/schema.prisma
RUN npm run build orders

# Production stage
FROM node:20-bullseye

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --only=production && npm cache clean --force

# Copy built files from builder
COPY --from=builder /app/dist ./dist

# 👇 Phần QUAN TRỌNG: copy toàn bộ engine và client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma

# 👇 Bổ sung: PRISMA_QUERY_ENGINE_BINARY và thư mục engines fallback
ENV PRISMA_QUERY_ENGINE_BINARY=/app/node_modules/.prisma/client/libquery_engine-debian-openssl-1.1.x.so.node
ENV PRISMA_GENERATE_SKIP_POSTINSTALL=1

# Xác thực engine tồn tại
RUN ls -l /app/node_modules/.prisma/client/ || true

# Expose TCP port (internal)
EXPOSE 3001

# Start application
CMD ["node", "dist/apps/orders/main.js"]

