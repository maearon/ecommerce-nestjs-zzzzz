generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("ORDERS_DATABASE_URL")
  directUrl = env("ORDERS_DATABASE_DIRECT_URL")
}

model Order {
  id          String       @id @default(uuid())
  customerId  String
  total       Decimal      @db.Decimal(10, 2)
  status      OrderStatus  @default(CREATED)
  items       OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  sku       String
  qty       Int
  price     Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sku])
  @@map("order_items")
}

enum OrderStatus {
  CREATED
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

